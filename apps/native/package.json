{
  "name": "company-native",
  "version": "0.1.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^25.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "keytar": "^8.0.0"
  },
  "build": {
    "appId": "com.company.autopoietic",
    "productName": "Company Engine",
    "directories": {
      "output": "dist"
    },
    "files": [
      "../web/**",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "zip"]
    },
    "mac": {
      "target": ["dmg", "zip"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  }
}
